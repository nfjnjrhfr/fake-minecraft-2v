[Unit]
Description=veil server (TLS-camouflaged encrypted tunnel)
Documentation=https://github.com/nfjnjrhfr/fake-minecraft-2v
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/veil-server -c /etc/veil/server.json
# SIGHUP picks up a renewed certificate without dropping live connections.
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s

User=veil
Group=veil

# Binding port 443 is the only privilege this needs; it gets that capability
# rather than root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# The certificate directory is read-only to the service; nothing else on the
# filesystem is writable at all.
ReadOnlyPaths=/etc/veil /etc/letsencrypt

# A proxy holds one file descriptor pair per connection, so the default limit
# is reached long before the machine is busy.
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
